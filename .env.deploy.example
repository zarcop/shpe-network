# The two hosted Supabase projects. Copy to .env.deploy (git-ignored) and fill in.
# Project refs and publishable keys are public; the database passwords are secrets.
#   Project ref: Project Settings → General (also the xxxx in https://xxxx.supabase.co)
#   Publishable key: Project Settings → API Keys

# Free org: fake people only, never real attendees.
STAGING_PROJECT_REF=
STAGING_DB_PASSWORD=
STAGING_PUBLISHABLE_KEY=

# Production: real attendees only, never seeded. Free plan with daily `make backup-production` (or Pro).
PRODUCTION_PROJECT_REF=
PRODUCTION_DB_PASSWORD=
PRODUCTION_PUBLISHABLE_KEY=

# Logo.dev (logos for colleges and companies, D18). The publishable key goes into the web builds and is public;
# the secret key is only for `make hub-logos` on this machine.
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=

# Gmail account that sends the sign-in codes (D19): turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords. Secret. Only used by `make email-setup`.
SMTP_USER=
SMTP_PASS=
